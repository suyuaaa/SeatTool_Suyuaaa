.container { padding: 20rpx; height: 100vh; display: flex; flex-direction: column; }
/* 首页 */
.home { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.title { font-size: 48rpx; font-weight: bold; margin-bottom: 80rpx; color: #333; }
.main-btn { width: 400rpx; height: 80rpx; line-height: 80rpx; margin-bottom: 30rpx; background-color: #1aad19; color: #fff; border-radius: 12rpx; font-size: 32rpx; }
.secondary { background-color: #07c160; }

/* 通用头部 */
.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: bold; }

/* 班级列表 */
.list { flex: 1; }
.class-card { background: #fff; padding: 30rpx; margin-bottom: 20rpx; border-radius: 16rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); }
.class-name { font-size: 34rpx; color: #333; }
.arrow { font-size: 36rpx; color: #999; }
.empty { text-align: center; color: #999; margin-top: 100rpx; }

/* 编辑表单 */
.form-scroll { flex: 1; }
.form-item { margin-bottom: 20rpx; }
.label { display: block; font-weight: bold; margin-bottom: 10rpx; }
.input, .small-input { border: 1rpx solid #ccc; border-radius: 8rpx; padding: 10rpx; margin-bottom: 10rpx; width: 100%; }
.section-title { font-weight: bold; font-size: 32rpx; margin: 20rpx 0 10rpx; border-left: 6rpx solid #1aad19; padding-left: 10rpx; }
.student-row, .dh-row, .occupied-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.student-row input, .dh-row input, .occupied-row input { flex: 1; margin-right: 10rpx; }
.podium-info { display: flex; align-items: center; justify-content: space-between; }
.save-btn { margin-top: 40rpx; background-color: #1aad19; color: #fff; }

/* 排座结果 */
.grid { flex: 1; background: #fff; border: 1rpx solid #ddd; }
.row { display: flex; }
.cell { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #ddd; font-size: 24rpx; }
.loading { text-align: center; padding: 40rpx; }